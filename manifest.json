{
    "manifest_version": 3,
    "name": "My Tab",
    "version": "1.0",
    "description": "A fast, polished custom favorites dashboard.",
    "permissions": [
        "bookmarks",
        "storage"
    ],
    "chrome_url_overrides": {
        "newtab": "dist/src/pages/newtab.html"
    },
    "icons": {
        "128": "dist/icons/icon128.png"
    }
}
